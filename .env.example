# Haraka backend - environment variables
# Copy to .env for local development. On Render, set these in
# Dashboard -> haraka-backend -> Environment. See ENVIRONMENT_VARIABLES.md.

# --- Application -----------------------------------------------------------
NODE_ENV=development
PORT=3000

# --- Database (PostgreSQL) -------------------------------------------------
DATABASE_URL=postgresql://haraka:haraka@localhost:5432/haraka
# Set to false for a local Postgres without SSL
DATABASE_SSL=false
# Auto-create/alter tables from the entities (default true). Set false once you use migrations.
DB_SYNCHRONIZE=true

# --- Authentication (REQUIRED in production) ---------------------------------
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Optional token lifetimes
JWT_STAFF_EXPIRES_IN=12h
JWT_COURIER_EXPIRES_IN=30d
JWT_MERCHANT_EXPIRES_IN=30d
# First super admin (only used when no super admin exists yet)
DEFAULT_ADMIN_EMAIL=admin@haraka.rw
DEFAULT_ADMIN_PASSWORD=

# --- Public URLs / CORS -----------------------------------------------------
# Admin dashboard URL (location-confirmation links + CORS). Leave empty to use the backend-hosted page.
FRONTEND_URL=
# Public URL of this backend (fallback for links). Render sets RENDER_EXTERNAL_URL automatically.
PUBLIC_BASE_URL=
# Extra allowed browser origins, comma separated (e.g. http://localhost:3001)
CORS_ORIGINS=

# --- Rate limiting ----------------------------------------------------------
RATE_LIMIT_PER_MINUTE=120

# --- Twilio SMS (customer + restaurant notifications) ------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Email (optional, Gmail app password) -----------------------------------
EMAIL_USER=
EMAIL_PASSWORD=

# --- PawaPay (Mobile Money) ------------------------------------------------
PAWAPAY_API_TOKEN=
# Optional override, defaults to https://api.pawapay.cloud (production)
PAWAPAY_API_URL=
# Webhook authentication: shared secret sent as X-Webhook-Secret header or ?secret= query
WEBHOOK_SECRET=
# Optional comma-separated IPs allowed to call the webhook
WEBHOOK_ALLOWED_IPS=

# --- Business rules ---------------------------------------------------------
# New courier registrations need admin approval (default true)
COURIER_REQUIRE_APPROVAL=true
# Flat service fee added to food orders (RWF)
FOOD_SERVICE_FEE=100
