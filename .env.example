# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Database
DATABASE_URL=postgresql://haraka:haraka123@localhost:5432/haraka
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=haraka
DATABASE_PASSWORD=haraka123
DATABASE_NAME=haraka

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Authentication
JWT_ACCESS_SECRET=your-super-secret-jwt-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Mapbox
MAPBOX_API_KEY=your-mapbox-api-key
MAPBOX_BASE_URL=https://api.mapbox.com

# Firebase Cloud Messaging
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project"}
FIREBASE_PROJECT_ID=your-firebase-project-id

# Africa's Talking (SMS & OTP)
AFRICASTALKING_API_KEY=your-africastalking-api-key
AFRICASTALKING_USERNAME=your-africastalking-username
AFRICASTALKING_SENDER_ID=HARAKA
AFRICASTALKING_ENVIRONMENT=sandbox

# pawaPay (Mobile Money)
PAWAPAY_API_KEY=your-pawapay-api-key
PAWAPAY_WEBHOOK_SECRET=your-pawapay-webhook-secret
PAWAPAY_BASE_URL=https://api.pawapay.io
PAWAPAY_ENVIRONMENT=sandbox

# Pricing Configuration (Rwanda Francs)
# Delivery fee per kilometer - MOTORCYCLE
MOTORCYCLE_BASE_FEE=500
MOTORCYCLE_RATE_0_3KM=0
MOTORCYCLE_RATE_3_5KM=200
MOTORCYCLE_RATE_5_10KM=150
MOTORCYCLE_RATE_10_PLUS_KM=100

# Delivery fee per kilometer - CAR
CAR_BASE_FEE=1000
CAR_RATE_0_3KM=0
CAR_RATE_3_5KM=300
CAR_RATE_5_10KM=250
CAR_RATE_10_PLUS_KM=200

# Commission & Earnings
MERCHANT_COMMISSION_RATE=0.15
COURIER_EARNING_RATE=0.70
PLATFORM_FEE_RATE=0.30

# Dispatch Configuration
INITIAL_SEARCH_RADIUS_KM=3
RADIUS_EXPANSION_KM=2
MAX_DISPATCH_ATTEMPTS=3
JOB_OFFER_TIMEOUT_SECONDS=20

# WebSocket
SOCKET_IO_CORS_ORIGIN=*
COURIER_LOCATION_UPDATE_INTERVAL_SECONDS=5

# File Upload
MAX_FILE_SIZE_MB=10
UPLOAD_DEST=./uploads

# App URLs
CUSTOMER_APP_URL=haraka://customer
MERCHANT_APP_URL=haraka://merchant
COURIER_APP_URL=haraka://courier
ADMIN_DASHBOARD_URL=http://localhost:3001
